{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.0",
  "contractId": "opensphere.cluster-manager.owner-capabilities/v1",
  "owner": "OpenSphere-Cluster-Manager",
  "capabilityProtocol": "opensphere.io/osaa-owner/v1",
  "capabilities": {
    "hiss": [
      "observability-config-read",
      "observability-plan",
      "observability-configure",
      "lifecycle-inspect",
      "lifecycle-execute"
    ],
    "ceph": [
      "status-read",
      "plan-from-import",
      "connect-from-import",
      "disconnect"
    ]
  },
  "security": {
    "identityAuthority": "Console API Identity / Session Broker",
    "readPermissionsAnyOf": ["console.role.admin", "console.role.operator", "console.role.viewer"],
    "mutationPermission": "console.role.admin",
    "assurance": "aal2",
    "assuranceException": "HTTPS loopback Console on edge; actual AAL1 retained",
    "delegation": "Current logged-in user; owner revalidates permission and session on every request",
    "secretInputPolicy": "StagedSecretRefOnly",
    "unknownProperties": "reject"
  }
}
