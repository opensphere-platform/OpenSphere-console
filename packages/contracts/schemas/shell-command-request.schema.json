{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "arguments",
    "requestId"
  ],
  "properties": {
    "command": {
      "enum": [
        "hiss.status",
        "hiss.inspect",
        "hiss.plan",
        "hiss.install",
        "hiss.uninstall",
        "hiss.upgrade",
        "hiss.recover",
        "hiss.rollback",
        "hiss.validate",
        "hiss.profiles.set",
        "hiss.observability.config",
        "hiss.observability.plan",
        "hiss.observability.configure"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "reviewRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.status"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.inspect"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "chartVersion": {
                "type": "string",
                "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.plan"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "config": {
                "type": "object"
              },
              "chartVersion": {
                "type": "string",
                "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.install"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              },
              "config": {
                "type": "object"
              },
              "chartVersion": {
                "type": "string",
                "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.uninstall"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              },
              "confirm": {
                "type": "string"
              },
              "chartVersion": {
                "type": "string",
                "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "required": [
              "id",
              "reason",
              "confirm"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.upgrade"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              },
              "chartVersion": {
                "type": "string",
                "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.recover"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              },
              "chartVersion": {
                "type": "string",
                "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.rollback"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "confirm": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.validate"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.profiles.set"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile": {
                "type": "string"
              },
              "selected": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.observability.config"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.observability.plan"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "config": {
                "type": "object"
              }
            },
            "required": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hiss.observability.configure"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "config": {
                "type": "object"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              },
              "resetData": {
                "type": "boolean"
              },
              "resetConfirmation": {
                "type": "string"
              },
              "publicConfirmation": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      }
    }
  ]
}
