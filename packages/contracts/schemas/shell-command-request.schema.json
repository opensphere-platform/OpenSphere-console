{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "arguments",
    "requestId"
  ],
  "properties": {
    "command": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "arguments": {
      "type": "object",
      "maxProperties": 32
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "reviewRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "description": "The envelope does not embed a module-specific command list. OS Shell resolves the active signed owner contract and validates arguments with its bounded closed schema before dispatch. Unknown or revoked commands fail closed."
}
