{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opensphere:cluster-manager-audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "action",
    "target",
    "outcome",
    "reason",
    "correlationId",
    "metadataDigest"
  ],
  "properties": {
    "source": {
      "const": "cluster-manager"
    },
    "action": {
      "type": "string",
      "pattern": "^(HIS|Ceph|OSAAHIS)[A-Za-z]{1,80}$"
    },
    "target": {
      "type": "string",
      "pattern": "^(HISS/[a-z0-9][a-z0-9/-]{0,127}|CephExternal/rook-ceph)$"
    },
    "outcome": {
      "enum": [
        "accepted",
        "succeeded",
        "failed",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "metadataDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
