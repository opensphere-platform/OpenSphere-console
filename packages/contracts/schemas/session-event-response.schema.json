{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:session-event-response:v1",
  "title": "Current subject browser session security history",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "session_id", "event", "result", "occurred_at"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "session_id": { "type": ["string", "null"], "format": "uuid" },
          "event": { "enum": ["login", "refresh", "step_up", "revoke", "revoke_all", "refresh_rejected"] },
          "result": { "enum": ["ok", "pending", "rejected", "error"] },
          "occurred_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
