{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "retryable": { "type": "boolean" },
    "correlationId": { "type": "string" },
    "operationId": { "type": ["string", "null"] },
    "details": { "type": "object" },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "sideEffect": {
      "enum": [
        "none",
        "unknown"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "controlPlane": {
      "const": "OS-Shell"
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
