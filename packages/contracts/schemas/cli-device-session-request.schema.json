{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:cli-device-session-request:v1",
  "title": "CLI device short-session proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "challengeId", "nonce", "signature"],
  "properties": {
    "deviceId": { "type": "string", "format": "uuid" },
    "challengeId": { "type": "string", "format": "uuid" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
