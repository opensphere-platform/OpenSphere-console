{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:opensphere:console:registry-credential-status:v1",
  "required": [
    "connectionId",
    "registryOrigin",
    "registry",
    "namespace",
    "contract",
    "credentialVersion",
    "phase",
    "configurationState",
    "authenticationMode",
    "refreshPolicy",
    "updatedAt",
    "username",
    "expiresAt",
    "refreshExpiresAt",
    "verifiedAt",
    "errorCode",
    "lastVerifiedAt",
    "lastVerificationCode",
    "credentialPresent",
    "verified",
    "oauthAvailable",
    "oauthProductionVerified",
    "synchronizedNamespaces",
    "requiredNamespaceCount",
    "authorization"
  ],
  "properties": {
    "connectionId": {
      "type": "string"
    },
    "registryOrigin": {
      "type": "string"
    },
    "registry": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "contract": {
      "type": "string"
    },
    "credentialVersion": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "Pending",
        "Ready",
        "Anonymous",
        "AwaitingAuthorization",
        "Removing",
        "Degraded",
        "Stale",
        "ReauthorizationRequired"
      ]
    },
    "configurationState": {
      "type": "string"
    },
    "authenticationMode": {
      "type": "string",
      "enum": [
        "pat",
        "github-device",
        "anonymous"
      ]
    },
    "refreshPolicy": {
      "type": "string",
      "enum": [
        "manual",
        "automatic",
        "reauthorize",
        "none"
      ]
    },
    "updatedAt": {
      "type": "string"
    },
    "username": {
      "type": [
        "string",
        "null"
      ]
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "refreshExpiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastVerifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastVerificationCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "credentialPresent": {
      "type": "boolean"
    },
    "verified": {
      "type": "boolean"
    },
    "oauthAvailable": {
      "type": "boolean"
    },
    "oauthProductionVerified": {
      "type": "boolean"
    },
    "synchronizedNamespaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "opensphere-console-data",
          "opensphere-console-change",
          "opensphere-monitoring",
          "opensphere-console",
          "opensphere-system"
        ]
      }
    },
    "requiredNamespaceCount": {
      "const": 5
    },
    "authorization": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userCode",
            "verificationUri",
            "expiresAt"
          ],
          "properties": {
            "userCode": {
              "type": "string",
              "pattern": "^[A-Z0-9]{4}-[A-Z0-9]{4}$"
            },
            "verificationUri": {
              "const": "https://github.com/login/device"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    }
  }
}
