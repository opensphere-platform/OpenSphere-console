{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:cli-device-enrollment-approval-response:v1",
  "title": "Approved CLI device",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "label", "fingerprint", "replayed"],
  "properties": {
    "deviceId": { "type": "string", "format": "uuid" },
    "label": { "type": "string", "minLength": 1, "maxLength": 128 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{2}(:[a-f0-9]{2}){31}$" },
    "replayed": { "type": "boolean" },
    "auditEventId": { "type": "string", "format": "uuid" }
  }
}
