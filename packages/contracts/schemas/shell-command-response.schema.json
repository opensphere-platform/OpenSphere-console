{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "controlPlane",
    "command",
    "requestId",
    "owner",
    "operationId",
    "observedAt",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "opensphere.shell-command/v1"
    },
    "controlPlane": {
      "const": "OS-Shell"
    },
    "command": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "operationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
