{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:platform-release-component-target-request:v1",
  "title": "Platform Release Component Target Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceRevision", "reason"],
  "anyOf": [{ "required": ["components"] }, { "required": ["auxiliaryArtifacts"] }],
  "properties": {
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "reason": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^[^\\r\\n]+$" },
    "auxiliaryArtifacts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4,
      "propertyNames": { "enum": ["cliArtifacts", "consoleIndexContent", "osShellControl", "osShellRuntime"] },
      "dependentRequired": {
        "osShellControl": ["cliArtifacts", "osShellRuntime"],
        "osShellRuntime": ["cliArtifacts", "osShellControl"]
      },
      "additionalProperties": { "$ref": "#/properties/components/additionalProperties" }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 18,
      "propertyNames": {
        "enum": ["console", "consoleApi", "extensionController", "registry", "osaaGateway", "osdst", "osaaGovernedAdapter", "notificationDispatcher", "gitea", "supabasePostgres", "supabaseAuth", "supabaseRest", "supabaseStorage", "giteaPostgres", "recovery", "beszelHub", "beszelAgent", "beszelBootstrap"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image"],
        "properties": {
          "image": {
            "type": "string",
            "pattern": "^(sha256:[a-f0-9]{64}|ghcr[.]io/opensphere-platform/[a-z0-9][a-z0-9-]*@sha256:[a-f0-9]{64})$"
          },
          "registryCredentialsRequired": { "type": "boolean" }
        }
      }
    }
  }
}
