{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:session-step-up-response:v1",
  "title": "Console recent AAL2 step-up response",
  "type": "object",
  "additionalProperties": false,
  "required": ["assurance", "reauthenticatedAt"],
  "properties": {
    "assurance": { "const": "aal2" },
    "reauthenticatedAt": { "type": "string", "format": "date-time" }
  }
}
