{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:session-touch-response:v1",
  "title": "Console trusted browser activity response",
  "type": "object",
  "additionalProperties": false,
  "required": ["session"],
  "properties": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "current", "status", "assurance", "persistence", "createdAt", "lastSeenAt", "idleExpiresAt", "absoluteExpiresAt", "userAgentDigest"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "current": { "const": true },
        "status": { "const": "active" },
        "assurance": { "enum": ["aal1", "aal2"] },
        "persistence": { "enum": ["browser", "1h", "4h", "8h", "12h", "24h", "3d", "7d", "14d", "30d"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "idleExpiresAt": { "type": "string", "format": "date-time" },
        "absoluteExpiresAt": { "type": "string", "format": "date-time" },
        "userAgentDigest": { "type": "null" }
      }
    }
  }
}
