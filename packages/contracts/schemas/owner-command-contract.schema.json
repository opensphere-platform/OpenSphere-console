{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSphere owner command contribution v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "version",
    "commands"
  ],
  "description": "Data-only signed asset. Shell additionally enforces owner prefix and unique IDs, same-contract read statusCommand, mutation reason, depth <=6 and <=256 schema nodes, ordered bounds and enum values. No URLs, remote refs, regular expressions, programs or privilege overrides can be supplied by an owner.",
  "properties": {
    "schema": {
      "const": "opensphere.owner-commands/v2"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tier": {
      "type": "string",
      "maxLength": 32
    },
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "mutation",
          "arguments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "mutation": {
            "type": "boolean"
          },
          "arguments": {
            "$ref": "#/$defs/argumentSchema"
          },
          "statusCommand": {
            "type": "string",
            "maxLength": 128
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mutation": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "statusCommand"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "argumentSchema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "maxLength"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "format": {
              "enum": [
                "uuid",
                "sha256",
                "git-revision",
                "dns-name",
                "semver"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "minimum",
            "maximum"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "minimum": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "minimum",
            "maximum"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "minimum": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "properties",
            "required",
            "additionalProperties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "additionalProperties": {
              "const": false
            },
            "properties": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,47}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "additionalProperties": {
                "$ref": "#/$defs/argumentSchema"
              }
            },
            "required": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items",
            "maxItems"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "minItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "items": {
              "$ref": "#/$defs/argumentSchema"
            }
          }
        }
      ]
    }
  }
}
