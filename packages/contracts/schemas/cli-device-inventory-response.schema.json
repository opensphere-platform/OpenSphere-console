{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:cli-device-inventory-response:v1",
  "title": "Current subject CLI device inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "fingerprint", "status", "createdAt", "lastUsedAt", "revokedAt", "lastSessionExpiresAt", "user"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "minLength": 1, "maxLength": 128 },
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{2}(:[a-f0-9]{2}){31}$" },
          "status": { "enum": ["active", "revoked"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "lastUsedAt": { "type": ["string", "null"], "format": "date-time" },
          "revokedAt": { "type": ["string", "null"], "format": "date-time" },
          "lastSessionExpiresAt": { "type": ["string", "null"], "format": "date-time" },
          "user": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
