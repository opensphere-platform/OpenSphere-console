{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:password-recovery-request:v1",
  "title": "Console password recovery completion request",
  "type": "object",
  "additionalProperties": false,
  "required": ["recoveryAccessToken", "password"],
  "properties": {
    "recoveryAccessToken": {
      "type": "string",
      "minLength": 64,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+[.][A-Za-z0-9_-]+$"
    },
    "password": { "type": "string", "minLength": 12, "maxLength": 1024 }
  }
}
