{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:registry-connection-verification-response:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "data", "authority", "observedAt", "freshness", "correlationId", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionId", "result", "credentialVersion", "authenticationMode", "expiresAt", "verifiedAt", "imageCount"],
      "properties": {
        "connectionId": { "const": "opensphere-ghcr" },
        "result": { "const": "Verified" },
        "credentialVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authenticationMode": { "enum": ["pat", "github-device"] },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "imageCount": { "type": "integer", "minimum": 0, "maximum": 128 }
      }
    },
    "authority": { "const": "GitHubContainerRegistry" },
    "observedAt": { "type": "string", "format": "date-time" },
    "freshness": { "const": "fresh" },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
