{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensphere.dev/contracts/session-preference-response.schema.json",
  "title": "Session preference response",
  "type": "object",
  "additionalProperties": false,
  "required": ["duration", "defaultDuration", "idleTimeoutHours", "appliesTo"],
  "properties": {
    "duration": {
      "enum": ["browser", "1h", "4h", "8h", "12h", "24h", "3d", "7d", "14d", "30d"]
    },
    "defaultDuration": { "const": "24h" },
    "idleTimeoutHours": { "const": 12 },
    "appliesTo": { "const": "next-login" }
  }
}
