{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "reason",
    "requestKey",
    "planRevision"
  ],
  "properties": {
    "id": {
      "enum": [
        "ingress-nginx",
        "cert-manager",
        "metrics-server",
        "crossplane-core",
        "kube-prometheus-stack"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500
    },
    "requestKey": {
      "type": "string",
      "pattern": "^r2d2-hiss-[a-f0-9]{64}$"
    },
    "planRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "confirm": {
      "enum": [
        "ingress-nginx",
        "cert-manager",
        "metrics-server",
        "crossplane-core",
        "kube-prometheus-stack"
      ]
    }
  }
}
