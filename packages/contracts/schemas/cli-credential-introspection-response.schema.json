{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:cli-credential-introspection-response:v1",
  "title": "CLI credential introspection projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["active", "userId", "subject", "deviceId", "groups", "permissions", "type", "expiresAt"],
  "properties": {
    "active": { "const": true },
    "userId": { "type": "string", "format": "uuid" },
    "subject": { "type": "string", "format": "uuid" },
    "deviceId": { "type": "string", "format": "uuid" },
    "groups": { "type": "array", "uniqueItems": true, "maxItems": 3, "items": { "enum": ["console-admins", "console-operators", "console-viewers"] } },
    "permissions": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "type": { "const": "cli" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
