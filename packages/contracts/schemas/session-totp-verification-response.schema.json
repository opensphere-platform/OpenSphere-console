{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:session-totp-verification-response:v1",
  "title": "Console verified TOTP enrollment response",
  "type": "object",
  "additionalProperties": false,
  "required": ["assurance", "sessionId"],
  "properties": {
    "assurance": { "const": "aal2" },
    "sessionId": { "type": "string", "format": "uuid" }
  }
}
