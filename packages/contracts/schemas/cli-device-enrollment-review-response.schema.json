{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:cli-device-enrollment-review-response:v1",
  "title": "Browser CLI enrollment review",
  "type": "object",
  "additionalProperties": false,
  "required": ["enrollmentId", "label", "fingerprint", "expiresAt", "status", "approvingUser"],
  "properties": {
    "enrollmentId": { "type": "string", "format": "uuid" },
    "label": { "type": "string", "minLength": 1, "maxLength": 128 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{2}(:[a-f0-9]{2}){31}$" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "status": { "const": "pending" },
    "approvingUser": { "type": "string", "format": "uuid" }
  }
}
