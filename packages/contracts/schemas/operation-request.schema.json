{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:operation-request:v1",
  "title": "Console Operation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actionId", "actionVersion", "targetRef", "payload", "reason", "risk", "planRevision"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "actionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "targetRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "payload": { "type": "object", "additionalProperties": true },
    "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
    "risk": { "enum": ["R0", "R1", "R2", "R3"] },
    "planRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "confirmation": { "type": ["string", "null"], "maxLength": 500 }
  }
}
