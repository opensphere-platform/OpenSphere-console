{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensphere.dev/contracts/managed-identity-create-request.schema.json",
  "title": "Managed Console identity creation",
  "type": "object",
  "additionalProperties": false,
  "required": ["username", "displayName", "email", "roles", "reason"],
  "properties": {
    "username": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,62}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\r\\n]+$" },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "roles": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["console-admins", "console-operators", "console-viewers"] }
    },
    "reason": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^[^\\r\\n]+$" }
  }
}
