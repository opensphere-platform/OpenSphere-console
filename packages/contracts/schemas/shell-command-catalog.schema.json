{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "controlPlane",
    "commands",
    "observedAt"
  ],
  "properties": {
    "schema": {
      "const": "opensphere.shell-command-catalog/v1"
    },
    "controlPlane": {
      "const": "OS-Shell"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "mutation",
          "arguments",
          "allowed",
          "description",
          "argumentSchema"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "mutation": {
            "type": "boolean"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "argumentSchema": {
            "type": "object",
            "required": [
              "type",
              "properties",
              "required",
              "additionalProperties"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "additionalProperties": {
                "const": false
              },
              "properties": {
                "type": "object",
                "maxProperties": 32
              },
              "required": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "contractSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "statusCommand": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
          }
        }
      },
      "maxItems": 260
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
