{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:initial-administrator-bootstrap-request:v1",
  "title": "Initial Console administrator bootstrap request",
  "type": "object",
  "additionalProperties": false,
  "required": ["username", "displayName", "email", "password", "passwordConfirm"],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9._-]{1,31}$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "email": { "type": "string", "minLength": 3, "maxLength": 254, "format": "email" },
    "password": { "type": "string", "minLength": 12, "maxLength": 1024 },
    "passwordConfirm": { "type": "string", "minLength": 12, "maxLength": 1024 }
  }
}
