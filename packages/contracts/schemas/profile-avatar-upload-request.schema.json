{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensphere.dev/contracts/profile-avatar-upload-request.schema.json",
  "title": "Profile avatar upload request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentType", "dataBase64"],
  "properties": {
    "contentType": { "enum": ["image/webp", "image/png", "image/jpeg"] },
    "dataBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 218460 }
  }
}
