{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:extension-candidate-request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptorId", "catalogRevision"],
  "properties": {
    "descriptorId": { "type": "string", "pattern": "^extension\\.[a-z0-9][a-z0-9-]{0,62}$" },
    "catalogRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
