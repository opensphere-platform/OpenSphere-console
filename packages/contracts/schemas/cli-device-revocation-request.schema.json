{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opensphere:console:cli-device-revocation-request:v1",
  "title": "CLI device revocation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason"],
  "properties": { "reason": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^[^\\r\\n]+$" } }
}
