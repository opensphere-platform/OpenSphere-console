{
  "apiVersion": "release.opensphere.io/v1alpha1",
  "kind": "ReleaseBuildAuthorityPolicy",
  "metadata": {
    "name": "opensphere-release-build-authority",
    "effectiveFrom": "2026-07-26",
    "state": "edge-ga-authority-enforced",
    "authority": "_DOCS_/01-CONSTITUTION/CONSTITUTION-0005-OCI-IMAGE-CHANNEL-PROMOTION-INSTALLATION-POLICY.md"
  },
  "spec": {
    "scope": {
      "artifacts": [
        "opensphere-console",
        "opensphere-setup",
        "opensphere-os-cli",
        "subshell-runtime-images",
        "plugin-runtime-images",
        "release-bom"
      ]
    },
    "releaseClasses": {
      "edge": {
        "tags": ["edge"],
        "officialDistribution": false,
        "allowedBuildAuthorities": ["localhost"],
        "localBuildAllowed": true,
        "requiredHost": "windows-amd64-docker-desktop",
        "requiredPlatform": "linux/amd64",
        "requiredPublication": [
          "ghcr-immutable-digest",
          "kst-yyyyMMddHHmm-version",
          "edge-channel-tag"
        ]
      },
      "preGa": {
        "tags": ["candidate", "stable"],
        "officialDistribution": false,
        "allowedBuildAuthorities": ["github-actions"],
        "localBuildAllowed": false,
        "evidenceMode": "required",
        "promotionToGa": {
          "retagArtifact": false,
          "sourceRevisionMayBeRebuilt": true
        }
      },
      "ga": {
        "tags": ["ga"],
        "officialDistribution": true,
        "allowedBuildAuthorities": ["github-actions"],
        "localBuildAllowed": false,
        "requiredEvidence": [
          "immutable-digest",
          "slsa-provenance",
          "spdx-sbom",
          "release-bom-attestation"
        ],
        "promotion": {
          "retagPreGaArtifact": false,
          "rebuildFromSourceInGaWorkflow": true
        }
      }
    },
    "requiredArtifactAnnotations": [
      "opensphere.io/build-authority",
      "opensphere.io/release-class",
      "opensphere.io/ga-eligible",
      "io.opensphere.release-tag",
      "org.opencontainers.image.version"
    ],
    "officialVersion": {
      "pattern": "^[0-9]{12}$",
      "format": "yyyyMMddHHmm",
      "timezone": "Asia/Seoul",
      "displayField": "artifactVersion",
      "compatibilityField": "compatibilityVersion",
      "forbiddenOfficialExamples": ["v0.2.2-edge.2", "0.2.2-edge.2", "latest"]
    },
    "platformPolicy": {
      "edge": {
        "mode": "windows-amd64-local-single",
        "requiredPlatforms": ["linux/amd64"]
      },
      "candidate": {
        "mode": "multi-platform",
        "requiredPlatforms": ["linux/amd64", "linux/arm64"]
      },
      "stable": {
        "mode": "multi-platform",
        "requiredPlatforms": ["linux/amd64", "linux/arm64"]
      },
      "ga": {
        "mode": "multi-platform",
        "requiredPlatforms": ["linux/amd64", "linux/arm64"]
      }
    },
    "enforcement": {
      "phase": "edge-ga-authority-enforced",
      "runtimeAdmissionUnchanged": false,
      "localEdge": {
        "channel": "edge",
        "platformMode": "windows-amd64-local-single",
        "requiredPlatform": "linux/amd64",
        "requiredHost": "windows-amd64-docker-desktop",
        "requiredBuildAuthority": "localhost",
        "requiredReleaseClass": "pre-ga",
        "gaEligible": false,
        "evidence": [
          "immutable-digest",
          "trusted-p256-module-signature",
          "local-edge-build-metadata",
          "ghcr-publication",
          "kst-yyyyMMddHHmm-version",
          "edge-channel-tag"
        ]
      },
      "channelUniqueness": {
        "mapping": "(canonical-image-id, channel) -> exactly-one canonical repository digest",
        "failClosed": true
      }
    }
  }
}
