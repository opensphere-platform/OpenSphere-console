FROM docker.io/library/golang@sha256:523c3effe300580ed375e43f43b1c9b091b68e935a7c3a92bfcc4e7ed55b18c2 AS build
ARG CLI_UPDATE_TRUST_ID
ARG CLI_UPDATE_TRUST_PUBLIC
WORKDIR /src
RUN apk add --no-cache bash && adduser -S -D -u 65531 runtime-test
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
RUN go test ./cmd/os-shell-runtime ./cmd/os && \
    go test -c -o /tmp/os-shell-runtime.test ./cmd/os-shell-runtime && \
    OPENSPHERE_SHELL_PID_STRESS_TEST=true su runtime-test -s /bin/sh -c '/tmp/os-shell-runtime.test -test.run=TestPTYProcessLimitForkStress -test.count=1' && \
    CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -o /tmp/opensphere-os-shell-runtime.exe ./cmd/os-shell-runtime && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.version=0.1.0" -o /out/opensphere-os-shell-runtime ./cmd/os-shell-runtime && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.version=0.8.2 -X main.updateProductionKeyID=${CLI_UPDATE_TRUST_ID} -X main.updateProductionPublicKey=${CLI_UPDATE_TRUST_PUBLIC}" -o /out/os ./cmd/os

FROM docker.io/library/alpine@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
ARG OPENSPHERE_VERSION=dev
LABEL org.opencontainers.image.title="OpenSphere OS Shell Runtime" \
      org.opencontainers.image.version="${OPENSPHERE_VERSION}" \
      org.opencontainers.image.vendor="OpenSphere" \
      io.opensphere.session-class="operator-interactive" \
      io.opensphere.runtime-adapter="cbss.kubernetes-pod"
RUN apk add --no-cache bash ca-certificates && \
    addgroup -S -g 65532 opensphere && \
    adduser -S -D -u 65532 -G opensphere -h /home/opensphere -s /bin/bash opensphere && \
    install -d -o 65532 -g 65532 -m 0750 /home/opensphere /run/opensphere-shell
COPY --from=build --chown=65532:65532 /out/opensphere-os-shell-runtime /usr/local/bin/opensphere-os-shell-runtime
COPY --from=build --chown=65532:65532 /out/os /usr/local/bin/os
USER 65532:65532
WORKDIR /home/opensphere
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/opensphere-os-shell-runtime"]
CMD ["pty"]
