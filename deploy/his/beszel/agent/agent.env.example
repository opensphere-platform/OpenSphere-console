# Public, non-secret CC2 Beszel agent settings.
#
# The service reads the key and token from the root-managed files below.
# Prefixing every variable avoids collisions with unrelated host services.
BESZEL_AGENT_HUB_URL=https://beszel.cc2.opl.io.kr
BESZEL_AGENT_SYSTEM_NAME=CMARS-OCI-CC-02-4X24
BESZEL_AGENT_DISABLE_SSH=true
BESZEL_AGENT_KEY_FILE=/etc/beszel-agent/key
BESZEL_AGENT_TOKEN_FILE=/etc/beszel-agent/token
BESZEL_AGENT_DATA_DIR=/var/lib/beszel-agent
BESZEL_AGENT_DOCKER_HOST=
BESZEL_AGENT_FILESYSTEM=/
BESZEL_AGENT_NICS=enp0s6
BESZEL_AGENT_SERVICE_PATTERNS=k3s*,rcc-node-agent*,ssh*,fail2ban*
BESZEL_AGENT_SKIP_GPU=true
BESZEL_AGENT_SMART_DEVICES=
BESZEL_AGENT_LOG_LEVEL=info
