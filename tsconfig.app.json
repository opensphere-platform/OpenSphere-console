/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/app/features/kubernetes/resources/ceph.component.ts",
    "src/app/features/kubernetes/resources/his.component.ts",
    "src/app/features/kubernetes/resources/mon-*.component.ts",
    "src/app/features/kubernetes/resources/mtv-*.component.ts",
    "src/app/features/kubernetes/resources/volumesnapshot*.component.ts",
    "src/app/features/kubernetes/resources/virtualmachines.component.ts",
    "src/app/features/kubernetes/resources/vm-*.component.ts",
    "src/app/features/kubernetes/shared/terminal.component.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
