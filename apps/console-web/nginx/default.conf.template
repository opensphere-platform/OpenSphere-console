# OpenSphere Console nginx — 셸이 유일한 관문(dynamic-ui §11):
# 브라우저는 엔진(rhdh-self)이나 기능 컨테이너를 직접 호출하지 않는다.
# 브라우저는 HttpOnly opaque session만 보유한다. 같은 origin의 Host API가
# 내부 auth_request에서 세션을 검증한 뒤 short-lived bearer만 workload에 전달하며,
# 신뢰 가능한 identity는 각 백엔드가 그 검증된 bearer로부터 다시 구성한다.

# WebSocket 업그레이드용(흡수앱의 exec/터미널·로그 스트리밍·watch). conf.d는 http{} 내부 →
# map은 여기(server 밖)에 둔다. Upgrade 헤더 있을 때만 Connection: upgrade(일반 API는 영향 없음).
map $http_upgrade $os_conn_upgrade { default upgrade; '' ''; }
map $http_x_os_correlation_id $os_correlation_id {
    "~^[A-Za-z0-9._:-]{1,128}$" $http_x_os_correlation_id;
    default $request_id;
}
log_format opensphere_json escape=json
    '{"time":"$time_iso8601","service":"opensphere-console","requestId":"$request_id",'
    '"correlationId":"$os_correlation_id","method":"$request_method","uri":"$request_uri",'
    '"status":$status,"bytes":$body_bytes_sent,"latency":$request_time,'
    '"upstreamStatus":"$upstream_status","upstreamLatency":"$upstream_response_time"}';
access_log /var/log/nginx/access.log opensphere_json;

server {
    listen 8080;                 # http — in-cluster readiness probe / 내부용
    listen 8443 ssl;             # https — LoadBalancer 외부 노출(콘솔은 https://localhost:1114)
    # Console TLS is served from shell-tls. HTTPS keeps the Supabase Auth
    # same-origin session flow stable without a separate browser auth host.
    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    resolver 10.96.0.10 valid=10s;

    # 요청 본문 상한(감사 H: DoS — 무제한 업로드 차단). 백엔드 readBody도 256KB 가드.
    client_max_body_size 1m;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    # CSP (Manifest v3 Host Contract): 인라인 스크립트·eval 금지.
    # - script-src blob: → Extension Host가 '검증된 바이트'(sha256+ECDSA)만 Blob URL로 import하는 경로
    # - style-src 'unsafe-inline' → Angular 컴포넌트 스타일 주입 방식상 필요
    # - connect-src ${OS_AUTH_ORIGIN} → OIDC discovery/token/logout + self proxy/secure WebSocket
    # - frame-src https://ceph.triangles.com → Cluster Manager의 read-only Ceph Grafana 화면
    # 감사 P1-1: 'unsafe-eval' 제거(콘솔/플러그인은 eval 미사용 — src 내 eval/new Function 0건). worker-src도
    #   'self' blob:로 축소(data: 제거). eval이 필요한 흡수 대형앱(Headlamp 등)은 별도 격리 CSP zone으로
    #   분리해 도입할 것(전역 약화 금지).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ${OS_AUTH_ORIGIN} wss:; frame-src 'self' ${OS_AUTH_ORIGIN} https://ceph.triangles.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-OS-Correlation-ID $os_correlation_id always;

    include /etc/nginx/target-api-routes.conf;

    # ADR-006 Supabase same-origin endpoints.  Console authentication is served
    # only by Supabase Auth; parallel legacy identity routes are deliberately absent.
    location ^~ /auth/v1/ {
        set $supabase_auth_upstream opensphere-supabase-auth.opensphere-console-data.svc.cluster.local;
        # proxy_pass uses a variable for Kubernetes DNS, which prevents its
        # normal prefix replacement. Rewrite explicitly before proxying.
        rewrite ^/auth/v1/(.*)$ /$1 break;
        proxy_pass http://$supabase_auth_upstream:9999;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-OpenSphere-User "";
        proxy_set_header X-OpenSphere-Actor "";
        proxy_set_header X-OS-Correlation-ID $os_correlation_id;
    }

    location ^~ /storage/v1/ {
        client_max_body_size 500m;
        set $supabase_storage_upstream opensphere-supabase-storage.opensphere-console-data.svc.cluster.local;
        # Storage follows the same external `/storage/v1` convention as Auth,
        # while its in-cluster service owns the path below that prefix.
        rewrite ^/storage/v1/(.*)$ /$1 break;
        proxy_pass http://$supabase_storage_upstream:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-OpenSphere-User "";
        proxy_set_header X-OpenSphere-Actor "";
        proxy_set_header X-OS-Correlation-ID $os_correlation_id;
        proxy_request_buffering off;
    }

    # Registry & Catalog public discovery. Mutation and deterministic resolve
    # stay inside CBSS; browsers receive the one read-only snapshot endpoint.
    location = /api/v1/registry {
        limit_except GET { deny all; }
        set $registry_api_upstream opensphere-registry.opensphere-console.svc.cluster.local;
        proxy_pass http://$registry_api_upstream:8080/api/v1/registry;
        proxy_set_header X-OS-Correlation-ID $os_correlation_id;
    }
    location = /api/v1/registry/resolve { return 404; }

    # Main Shell native os CLI. Artifact compilation and rollout are intentionally
    # independent from the Angular shell; this route only preserves the stable
    # same-origin download contract exposed to administrators and `os update`.
    location /api/cli/ {
        # /api/cli is artifact delivery only. A retired CLI once posted its login
        # request here and nginx's default HTML 405 leaked into the terminal.
        # Keep the API error contract machine-readable even for stale clients.
        error_page 404 = @cli_artifact_not_found;
        error_page 502 503 504 = @cli_artifact_unavailable;
        error_page 418 = @cli_method_not_allowed;
        if ($request_method !~ ^(GET|HEAD)$) { return 418; }
        proxy_intercept_errors on;
        # os-cli is rolled out independently after the Main Shell. Resolve it at
        # request time so a clean installation can start the Console before the
        # optional artifact service exists. Preserve the historical prefix-strip
        # contract: /api/cli/index.json is served as /index.json upstream.
        set $cli_artifact_upstream os-cli.opensphere-console.svc.cluster.local;
        rewrite ^/api/cli/(.*)$ /$1 break;
        proxy_pass http://$cli_artifact_upstream:8080;
        proxy_set_header X-OS-Correlation-ID $os_correlation_id;
    }

    location @cli_method_not_allowed {
        default_type application/json;
        add_header Allow "GET, HEAD" always;
        return 405 '{"error":"method_not_allowed","message":"/api/cli/ is a GET-only CLI artifact endpoint. Authentication uses /api/identity/cli/."}';
    }

    location @cli_artifact_not_found {
        default_type application/json;
        return 404 '{"error":"cli_artifact_not_found","message":"The requested CLI artifact does not exist."}';
    }

    location @cli_artifact_unavailable {
        default_type application/json;
        add_header Retry-After "5" always;
        return 503 '{"error":"cli_artifact_service_unavailable","message":"The CLI artifact service is not ready. Console UI remains available."}';
    }

    # Opaque OS Shell renderer. `allow-same-origin` is intentionally absent on
    # the parent iframe; this child receives terminal frames only through a
    # transferred MessagePort and has no network capability of its own.
    location ^~ /os-shell-frame/ {
        try_files $uri =404;
        # xterm's DOM renderer generates per-instance cursor, selection, and ANSI palette
        # rules. Permit those styles only inside this sandboxed, network-disabled frame.
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'none'; img-src 'none'; font-src 'self' data:; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'" always;
        # The sandbox deliberately gives this frame an opaque origin. The
        # standalone parent uses COEP=require-corp, so this route must opt in
        # explicitly while CSP frame-ancestors still limits embedding to this
        # Console origin.
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-read=(), clipboard-write=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-OS-Correlation-ID $os_correlation_id always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Extension-free OS Shell top-level realm. Unlike the ordinary Console
    # document this response cannot execute Blob modules or workers and cannot
    # be embedded/opened with a live opener relationship. The Angular image is
    # reused, but its immutable startup mode never instantiates ExtensionHost.
    location = /shell {
        try_files /index.html =404;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-read=(), clipboard-write=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-OS-Correlation-ID $os_correlation_id always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Canonicalize the only accepted trailing-slash alias with a real
    # navigation. Nginx URI normalization also collapses duplicate slashes and
    # percent-decodes unreserved characters before exact location matching.
    location = /shell/ {
        # Keep the canonicalization on the browser-visible origin. Nginx
        # otherwise expands the relative target with its internal 8443
        # listener, which is not the localhost edge front-door port.
        absolute_redirect off;
        return 308 /shell;
    }

    # 해시드 자산(main-<hash>.js 등)은 내용 불변 → 장기 immutable 캐시
    location ~* "-[A-Za-z0-9]{8,}\.(?:js|css)$" {
        # RollingUpdate 동안 새 index와 이전 Pod가 잠시 공존할 수 있다.
        # 이전 Pod에 없는 새 hash 자산은 절대 immutable 404로 캐시하지 않는다.
        try_files $uri @missing_hashed_asset;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-OS-Correlation-ID $os_correlation_id always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location @missing_hashed_asset {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "no-store, max-age=0" always;
        return 404;
    }

    # index.html(문서)은 캐시 금지 → 배포로 자산 해시가 바뀌어도 항상 최신 index를 받아
    # 새 해시 자산을 참조(구 index 캐시로 인한 'Failed to load module script' 빈 화면 방지).
    # add_header는 자식 location에서 부모를 '대체'하므로 CSP/nosniff를 여기서 다시 선언한다.
    location = /index.html {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ${OS_AUTH_ORIGIN} wss:; frame-src 'self' ${OS_AUTH_ORIGIN} https://ceph.triangles.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-OS-Correlation-ID $os_correlation_id always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # SPA 라우팅
    location / {
        try_files $uri $uri/ /index.html;
    }
}
